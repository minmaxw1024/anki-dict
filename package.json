{
  "name": "anki-dict-extension",
  "version": "1.0.0",
  "description": "Browser extension for looking up English words and exporting to Anki (Chrome, Edge & Firefox)",
  "type": "module",
  "scripts": {
    "dev": "BROWSER=chrome vite build --watch --mode development",
    "dev:chrome": "BROWSER=chrome vite build --watch --mode development",
    "dev:firefox": "BROWSER=firefox vite build --watch --mode development",
    "start:firefox": "web-ext run -s dist/firefox --start-url https://en.wikipedia.org/wiki/Serendipity",
    "lint:firefox": "web-ext lint -s dist/firefox",
    "build": "bun run build:chrome && bun run build:firefox && bun run build:edge",
    "build:chrome": "BROWSER=chrome tsc --noEmit && BROWSER=chrome vite build",
    "build:firefox": "BROWSER=firefox tsc --noEmit && BROWSER=firefox vite build",
    "build:edge": "BROWSER=edge tsc --noEmit && BROWSER=edge vite build",
    "pack": "bun run build && bun run pack:chrome && bun run pack:firefox && bun run pack:edge",
    "pack:chrome": "node scripts/zip.mjs chrome",
    "pack:firefox": "node scripts/zip.mjs firefox",
    "pack:edge": "node scripts/zip.mjs edge",
    "pack:firefox-source": "node scripts/zip-source.mjs",
    "type-check": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "build-for-amo": "npx --yes bun@1.4.3 install --frozen-lockfile && npx --yes bun@1.4.3 run build:firefox"
  },
  "keywords": [
    "chrome-extension",
    "firefox-extension",
    "anki",
    "dictionary",
    "cambridge",
    "vocabulary"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/webextension-polyfill": "^0.12.4",
    "happy-dom": "^21.0.3",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^3",
    "web-ext": "^10.8.0"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.3.0",
    "webextension-polyfill": "^0.12.0"
  }
}
